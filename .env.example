SECRET_KEY=change-this-in-production
FLASK_CONFIG=development
DATABASE_URL=mysql+pymysql://root:root@localhost:3306/workforceiq?charset=utf8mb4

# Set to 1 ONLY when serving over HTTPS (keep 0 for http://localhost)
SESSION_COOKIE_SECURE=0

# AWS S3 (optional - falls back to local static/uploads when unset)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1

# SMTP (optional - notifications still stored in dashboard when unset)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SENDER=no-reply@workforceiq.local
